# Copy to .env and fill in. .env is gitignored — never commit the real values.
#   cp .env.example .env

# ─── Yahoo ────────────────────────────────────────────────────────────────────
# From developer.yahoo.com/apps/ after creating the app.
# Yahoo labels these "Client ID (Consumer Key)" and "Client Secret (Consumer Secret)".
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Must match EXACTLY what you entered as the Redirect URI in the Yahoo app form,
# character for character — including https, port, and path. A mismatch here is the
# single most common cause of a failed token exchange.
YAHOO_REDIRECT_URI=https://localhost:8000/callback

# Your league's numeric ID (from the Yahoo league URL / settings page).
YAHOO_LEAGUE_ID=878541

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# Model settings. Opus 5 is the default; effort trades latency for depth.
# low | medium | high | xhigh | max
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high

# ─── Draft / league shape ─────────────────────────────────────────────────────
LEAGUE_TEAMS=10
DRAFT_ROUNDS=16

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8000

# How often to poll Yahoo for new picks, in seconds. 5-10 is sensible; going much
# lower risks rate limiting without making the board meaningfully fresher.
POLL_INTERVAL_SECONDS=8

# Set to 1 to run a simulated draft with no Yahoo credentials.
MOCK_MODE=0
